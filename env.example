# Kiko — proposed environment contract (2026-10-16)
# Documentation only: no application loader has been implemented/verified.
# Reconcile names with accepted ADRs and actual SDK versions at bootstrap.
# No real secrets belong here. All REPLACE_* values are nonfunctional placeholders.
# Blank required security/limit settings MUST fail validation, not mean unlimited.
# Do not print complete environment values or commit populated env files.

# Application: runtime NODE_ENV is managed by framework/hosting, not repurposed here.
KIKO_ENVIRONMENT=local
KIKO_APP_ORIGIN=http://localhost:3000
# Local URL is a proposed default; replace after verifying the actual dev server.
KIKO_DEFAULT_UI_LANGUAGE=vi
KIKO_DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh
# Supported languages are a validated application registry: zh, ja, en.
# Account admission and roles are persisted, not trusted from browser/env claims.

# Proposed Supabase integration — configure only if selected.
# NEXT_PUBLIC_* is intentionally browser-visible; never place privileged keys here.
NEXT_PUBLIC_SUPABASE_URL=https://REPLACE_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=REPLACE_PUBLIC_PUBLISHABLE_KEY
# If the selected project/SDK requires a legacy anon key, choose/document that
# alternative explicitly; do not configure competing public-key names blindly.

# Server-only DB. Use a least-privilege runtime identity and separate migration access.
DATABASE_URL=postgresql://REPLACE_RUNTIME_USER:REPLACE_RUNTIME_PASSWORD@REPLACE_DB_HOST:5432/REPLACE_DB_NAME
# Direct URL is for reviewed migration tooling only if its config uses this name.
# Its mere presence must not cause startup/CI to migrate a shared database.
DIRECT_URL=postgresql://REPLACE_MIGRATION_USER:REPLACE_MIGRATION_PASSWORD@REPLACE_DIRECT_HOST:5432/REPLACE_DB_NAME
# Configure TLS/pooling using selected provider/runtime documentation.
# Do not disable certificate validation or expose these variables to the browser.

# Server-only privileged provider credential: optional, only when a documented
# administrative/storage operation actually requires it. Never use in browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Private buckets: proposed names, provisioning/policies must be configured separately.
KIKO_STORAGE_PRIVATE_BUCKET=kiko-private
KIKO_STORAGE_CATALOG_BUCKET=kiko-catalog
KIKO_STORAGE_STAGING_BUCKET=kiko-staging
# Catalog is shared only with authorized Kiko users, not implicitly public.

# Operational limits — choose during P0 and enforce server-side.
# Define supported MIME/container allowlists in versioned code after device tests.
KIKO_UPLOAD_MAX_BYTES=
KIKO_MEDIA_MAX_DURATION_SECONDS=
KIKO_ACCOUNT_STORAGE_LIMIT_BYTES=
KIKO_SIGNED_READ_TTL_SECONDS=
KIKO_SIGNED_UPLOAD_TTL_SECONDS=
KIKO_UPLOAD_RESERVATION_TTL_SECONDS=
KIKO_EXPORT_ARTIFACT_TTL_SECONDS=
KIKO_IMPORT_MAX_ARCHIVE_BYTES=
KIKO_IMPORT_MAX_EXTRACTED_BYTES=
KIKO_IMPORT_MAX_FILE_COUNT=
KIKO_STROKE_MAX_POINTS=
KIKO_TRANSCRIPT_MAX_SEGMENTS=
# Limits must be positive bounded integers, with cross-field validation where needed.

# Jobs: disabled until a real authorized worker runtime and scoped handlers exist.
KIKO_JOBS_ENABLED=false
KIKO_JOB_MAX_ATTEMPTS=
KIKO_JOB_LEASE_SECONDS=
# No public cron endpoint or generic job-execution secret is implied by this file.

# AI: disabled by default; provider-specific keys are added only after selection.
KIKO_AI_ENABLED=false
KIKO_AI_PROVIDER=
KIKO_AI_MODEL=
KIKO_AI_DAILY_AUDIO_LIMIT_SECONDS=
KIKO_AI_MONTHLY_BUDGET_AMOUNT=
KIKO_AI_BUDGET_CURRENCY=
# Enabling AI additionally requires approved data flow, permission, quota, consent
# behavior and provider-specific secure configuration; this switch alone is not consent.

# Observability: content/secret payload logging remains prohibited by code policy.
KIKO_LOG_LEVEL=info
KIKO_EXTERNAL_TELEMETRY_ENABLED=false
# Do not add plaintext private audio/transcripts, bearer tokens, signed URLs or
# real identities to logs, sample values, CI artifacts, repository or issue reports.
