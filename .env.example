# Kiko — environment contract (updated 2026-10-17)
# Copy to .env.local (git-ignored) and fill values through a secure channel.
# No real secrets belong here. All REPLACE_* values are nonfunctional placeholders.
# Variables marked [used] are read by the current code; [proposed] ones are a
# contract for later slices and are not read yet.
# Blank required security/limit settings MUST fail validation, not mean unlimited.
# Do not print complete environment values or commit populated env files.

# --- Supabase Auth (DEC-001) ------------------------------------------------
# [used] Browser-visible by design (NEXT_PUBLIC_*). Never put a secret key here:
# the app refuses keys starting with sb_secret_.
# Dashboard: Project Settings → API (Project URL, publishable key).
NEXT_PUBLIC_SUPABASE_URL=https://REPLACE_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE

# --- Database (DEC-005, DEC-006) --------------------------------------------
# [used] Web runtime: least-privilege role kiko_app through the Supavisor
# transaction pooler (port 6543), verified TLS in pg's dialect (DEC-015).
# The app refuses postgres/service_role and remote URLs without verify-full.
# Do not write this by hand: `npm run db:provision-runtime -- --yes` creates
# the kiko_app password and writes this line to .env.local (DEC-017).
DATABASE_URL=postgresql://kiko_app.REPLACE_PROJECT_REF:REPLACE_GENERATED@REPLACE_REGION.pooler.supabase.com:6543/postgres?sslmode=verify-full&sslrootcert=/ABSOLUTE/PATH/supabase-ca.crt

# [used by Prisma CLI and scripts/*.mjs only] Migration/operator identity
# through the session pooler (port 5432). Verified TLS in Prisma's dialect:
# sslaccept=strict is required, sslcert is the Supabase CA certificate path.
# Its presence never triggers migrations; `npm run db:migrate:deploy` is manual.
DIRECT_URL=postgresql://postgres.REPLACE_PROJECT_REF:REPLACE_POSTGRES_PASSWORD@REPLACE_REGION.pooler.supabase.com:5432/postgres?sslmode=require&sslaccept=strict&sslcert=/ABSOLUTE/PATH/supabase-ca.crt

# The CA certificate is public (Dashboard → Database → Settings → SSL
# Configuration → Download certificate). Keep it outside the repository, e.g.
# ~/.config/kiko/supabase-ca.crt. Never disable certificate validation.

# [used by npm run test:integration only] Local, disposable test database.
# The suite DROPS schema `kiko` there on every run. Must be localhost and must
# differ from DATABASE_URL/DIRECT_URL (DEC-014).
KIKO_TEST_DATABASE_URL=postgresql://REPLACE_LOCAL_USER@localhost:5432/kiko_flashcard

# --- Application ------------------------------------------------------------
# [used] Default for the onboarding timezone field. Must be an IANA name.
KIKO_DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh
# [proposed] Not read yet; the email-OTP flow needs no redirect origin.
KIKO_ENVIRONMENT=local
KIKO_APP_ORIGIN=http://localhost:8080
KIKO_DEFAULT_UI_LANGUAGE=vi
# Supported languages are a validated application registry: zh, ja, en.
# Account admission and roles are persisted, not trusted from browser/env claims.

# [proposed] Server-only privileged provider credential: only when a documented
# administrative operation requires it. Not used by slice 1. Never in browser code.
SUPABASE_SERVICE_ROLE_KEY=

# --- Storage [proposed] -------------------------------------------------------
KIKO_STORAGE_PRIVATE_BUCKET=kiko-private
KIKO_STORAGE_CATALOG_BUCKET=kiko-catalog
KIKO_STORAGE_STAGING_BUCKET=kiko-staging
# Catalog is shared only with authorized Kiko users, not implicitly public.

# --- Operational limits [proposed] — choose during P0, enforce server-side ----
KIKO_UPLOAD_MAX_BYTES=
KIKO_MEDIA_MAX_DURATION_SECONDS=
KIKO_ACCOUNT_STORAGE_LIMIT_BYTES=
KIKO_SIGNED_READ_TTL_SECONDS=
KIKO_SIGNED_UPLOAD_TTL_SECONDS=
KIKO_UPLOAD_RESERVATION_TTL_SECONDS=
KIKO_EXPORT_ARTIFACT_TTL_SECONDS=
KIKO_IMPORT_MAX_ARCHIVE_BYTES=
KIKO_IMPORT_MAX_EXTRACTED_BYTES=
KIKO_IMPORT_MAX_FILE_COUNT=
KIKO_STROKE_MAX_POINTS=
KIKO_TRANSCRIPT_MAX_SEGMENTS=
# Limits must be positive bounded integers, with cross-field validation where needed.

# --- Jobs [proposed] — disabled until a real worker runtime exists -----------
KIKO_JOBS_ENABLED=false
KIKO_JOB_MAX_ATTEMPTS=
KIKO_JOB_LEASE_SECONDS=

# --- AI [proposed] — disabled by default; keys added only after selection ----
KIKO_AI_ENABLED=false
KIKO_AI_PROVIDER=
KIKO_AI_MODEL=
KIKO_AI_DAILY_AUDIO_LIMIT_SECONDS=
KIKO_AI_MONTHLY_BUDGET_AMOUNT=
KIKO_AI_BUDGET_CURRENCY=
# Enabling AI additionally requires approved data flow, permission, quota, consent
# behavior and provider-specific secure configuration; this switch alone is not consent.

# --- Observability [proposed] -------------------------------------------------
KIKO_LOG_LEVEL=info
KIKO_EXTERNAL_TELEMETRY_ENABLED=false
# Do not add plaintext private audio/transcripts, bearer tokens, signed URLs or
# real identities to logs, sample values, CI artifacts, repository or issue reports.
