// Kiko business schema, owned by Prisma Migrate (docs/DECISIONS.md, DEC-006).
//
// Everything Prisma cannot express lives in hand-written SQL migrations next to
// the generated ones: CHECK constraints, reference data, the kiko_app runtime
// role, grants, RLS policies and the controlled admission function.
// Tables live in the dedicated `kiko` schema, which the Supabase Data API does
// not expose.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["kiko"]
}

enum AccountState {
  pending
  active
  suspended
  removed

  @@map("account_state")
  @@schema("kiko")
}

enum LessonStatus {
  draft
  ready
  archived

  @@map("lesson_status")
  @@schema("kiko")
}

enum TranscriptState {
  draft
  published

  @@map("transcript_state")
  @@schema("kiko")
}

enum AdmissionStatus {
  active
  revoked

  @@map("admission_status")
  @@schema("kiko")
}

/// Supported target languages (zh, ja, en). Seeded by migration.
model Language {
  code String @id

  preferences UserLanguagePreference[]
  lessons     Lesson[]
  vocabulary  VocabularyItem[]
  decks       Deck[]

  @@map("language")
  @@schema("kiko")
}

/// Fixed role registry (OWNER, LEARNER). Seeded by migration.
model Role {
  code String @id

  userRoles           UserRole[]
  allowedAccountRoles AllowedAccountRole[]

  @@map("role")
  @@schema("kiko")
}

/// Kiko account bound to one provider identity. Created only by
/// kiko.admit_identity(); the web runtime can update preference columns only.
model UserProfile {
  id                      String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authProvider            String       @map("auth_provider")
  authSubject             String       @map("auth_subject")
  /// IANA timezone; null until onboarding.
  timezone                String?
  interfaceLanguage       String       @default("en") @map("interface_language")
  /// Name shown in the account menu; seeded once from the Google profile, display only.
  displayName             String?      @map("display_name")
  /// Header learning-language choice; composite FK to the user's own preference (SQL migration).
  currentLearningLanguage String?      @map("current_learning_language")
  state                   AccountState @default(pending)
  /// Incremented whenever state or roles change; guards in-flight writes.
  authorizationRevision   Int          @default(1) @map("authorization_revision")
  onboardedAt             DateTime?    @map("onboarded_at") @db.Timestamptz(6)
  version                 Int          @default(1)
  createdAt               DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  roles                UserRole[]               @relation("UserRoleUser")
  assignedRoles        UserRole[]               @relation("UserRoleAssignedBy")
  languagePreferences  UserLanguagePreference[]
  boundAllowedAccounts AllowedAccount[]         @relation("AllowedAccountBoundUser")
  admittedAccounts     AllowedAccount[]         @relation("AllowedAccountAdmittedBy")
  auditEvents          AuditEvent[]
  lessons              Lesson[]
  vocabulary           VocabularyItem[]
  decks                Deck[]

  @@unique([authProvider, authSubject])
  @@map("user_profile")
  @@schema("kiko")
}

/// Email admitted by an Owner/operator before first sign-in. Bound to the
/// provider subject at first admission so later email changes cannot rebind it.
model AllowedAccount {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authProvider String          @default("supabase") @map("auth_provider")
  /// Normalized (trimmed, lower-case); enforced by CHECK.
  email        String
  status       AdmissionStatus @default(active)
  boundSubject String?         @map("bound_subject")
  boundUserId  String?         @map("bound_user_id") @db.Uuid
  admittedById String?         @map("admitted_by") @db.Uuid
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  boundUser  UserProfile?         @relation("AllowedAccountBoundUser", fields: [boundUserId], references: [id], onDelete: Restrict)
  admittedBy UserProfile?         @relation("AllowedAccountAdmittedBy", fields: [admittedById], references: [id], onDelete: Restrict)
  roles      AllowedAccountRole[]

  @@unique([authProvider, email])
  @@unique([authProvider, boundSubject])
  @@map("allowed_account")
  @@schema("kiko")
}

/// Roles granted on admission.
model AllowedAccountRole {
  allowedAccountId String @map("allowed_account_id") @db.Uuid
  roleCode         String @map("role_code")

  allowedAccount AllowedAccount @relation(fields: [allowedAccountId], references: [id], onDelete: Cascade)
  role           Role           @relation(fields: [roleCode], references: [code], onDelete: Restrict)

  @@id([allowedAccountId, roleCode])
  @@map("allowed_account_role")
  @@schema("kiko")
}

model UserRole {
  userId       String   @map("user_id") @db.Uuid
  roleCode     String   @map("role_code")
  assignedById String?  @map("assigned_by") @db.Uuid
  assignedAt   DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)

  user       UserProfile  @relation("UserRoleUser", fields: [userId], references: [id], onDelete: Restrict)
  role       Role         @relation(fields: [roleCode], references: [code], onDelete: Restrict)
  assignedBy UserProfile? @relation("UserRoleAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)

  @@id([userId, roleCode])
  @@map("user_role")
  @@schema("kiko")
}

/// Learning languages chosen by the learner; a preference, not a permission.
model UserLanguagePreference {
  userId       String   @map("user_id") @db.Uuid
  languageCode String   @map("language_code")
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user     UserProfile @relation(fields: [userId], references: [id], onDelete: Restrict)
  language Language    @relation(fields: [languageCode], references: [code], onDelete: Restrict)

  @@id([userId, languageCode])
  @@map("user_language_preference")
  @@schema("kiko")
}

/// Append-only security/admin audit trail. No tokens, emails or content.
model AuditEvent {
  id          BigInt   @id @default(autoincrement())
  occurredAt  DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  targetType  String?  @map("target_type")
  targetId    String?  @map("target_id")
  result      String

  actor UserProfile? @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([occurredAt])
  @@map("audit_event")
  @@schema("kiko")
}

/// Private lesson owned by one Learner (DEC-020, DEC-024). Content lives in
/// transcript versions; the active one is published and immutable.
model Lesson {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId            String       @map("owner_id") @db.Uuid
  languageCode       String       @map("language_code")
  title              String
  status             LessonStatus @default(draft)
  /// "Ghi chú nguồn" (DEC-023).
  sourceNote         String?      @map("source_note")
  /// "Chủ đề" (DEC-023): up to 5 topics.
  tags               String[]     @default([])
  /// Optional self-assigned level label (DEC-023); never a certification.
  levelLabel         String?      @map("level_label")
  activeTranscriptId String?      @map("active_transcript_id") @db.Uuid
  /// Idempotency key from the create form.
  clientRequestId    String?      @map("client_request_id")
  version            Int          @default(1)
  archivedAt         DateTime?    @map("archived_at") @db.Timestamptz(6)
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner              UserProfile            @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  language           Language               @relation(fields: [languageCode], references: [code], onDelete: Restrict)
  transcriptVersions TranscriptVersion[]    @relation("LessonVersions")
  occurrences        VocabularyOccurrence[]
  activeTranscript   TranscriptVersion?     @relation("LessonActiveTranscript", fields: [activeTranscriptId, id], references: [id, lessonId], onDelete: NoAction, onUpdate: NoAction)

  @@unique([id, ownerId, languageCode])
  @@unique([ownerId, clientRequestId])
  @@index([ownerId, status, updatedAt(sort: Desc), id])
  @@index([tags], type: Gin)
  @@map("lesson")
  @@schema("kiko")
}

/// One version of a lesson's text. Published versions are immutable.
model TranscriptVersion {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lessonId         String          @map("lesson_id") @db.Uuid
  ownerId          String          @map("owner_id") @db.Uuid
  languageCode     String          @map("language_code")
  versionNo        Int             @map("version_no")
  state            TranscriptState @default(draft)
  /// Text exactly as submitted (DEC-021).
  sourceText       String          @map("source_text")
  segmentationRule String          @map("segmentation_rule")
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt      DateTime?       @map("published_at") @db.Timestamptz(6)

  lesson         Lesson                 @relation("LessonVersions", fields: [lessonId, ownerId, languageCode], references: [id, ownerId, languageCode], onDelete: Cascade, onUpdate: Cascade)
  activeInLesson Lesson[]               @relation("LessonActiveTranscript")
  segments       Segment[]
  occurrences    VocabularyOccurrence[]

  @@unique([lessonId, versionNo])
  @@unique([id, ownerId, languageCode])
  @@unique([id, lessonId])
  @@map("transcript_version")
  @@schema("kiko")
}

/// One non-blank line of a transcript version, stored verbatim ("đoạn").
model Segment {
  id                  String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transcriptVersionId String @map("transcript_version_id") @db.Uuid
  ownerId             String @map("owner_id") @db.Uuid
  languageCode        String @map("language_code")
  position            Int
  text                String

  transcriptVersion TranscriptVersion      @relation(fields: [transcriptVersionId, ownerId, languageCode], references: [id, ownerId, languageCode], onDelete: Cascade, onUpdate: Cascade)
  occurrences       VocabularyOccurrence[]

  @@unique([transcriptVersionId, position])
  /// Target of composite FKs from vocabulary occurrences (KIKO-009).
  @@unique([id, ownerId, languageCode])
  @@map("segment")
  @@schema("kiko")
}

// ---------------------------------------------------------------------------
// Vocabulary (KIKO-009, PROJECT_SPEC FR04–FR05, DATA_MODEL §7, DEC-044).
// Every child row carries owner_id + language_code and references its parent
// through a composite FK, so cross-owner and cross-language links are rejected
// by the database. Invariants, guards and grants: *_vocabulary_security.sql.

/// A word or phrase saved by one learner in one language.
model VocabularyItem {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId         String    @map("owner_id") @db.Uuid
  languageCode    String    @map("language_code")
  /// Exactly as typed (Unicode preserved).
  surface         String
  /// Duplicate-warning key: NFC + trimmed, lower-cased for English only (app-computed).
  surfaceKey      String    @map("surface_key")
  meaning         String
  notes           String?
  usage           String?
  starred         Boolean   @default(false)
  tags            String[]  @default([])
  clientRequestId String?   @map("client_request_id")
  version         Int       @default(1)
  archivedAt      DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner         UserProfile            @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  language      Language               @relation(fields: [languageCode], references: [code], onDelete: Restrict)
  readings      Pronunciation[]
  examples      VocabularyExample[]
  occurrences   VocabularyOccurrence[]
  deckItems     DeckItem[]
  relationsFrom VocabularyRelation[]   @relation("RelationFrom")
  relationsTo   VocabularyRelation[]   @relation("RelationTo")

  @@unique([id, ownerId, languageCode])
  @@unique([ownerId, clientRequestId])
  @@index([ownerId, languageCode, createdAt(sort: Desc), id])
  @@index([ownerId, languageCode, surfaceKey])
  @@index([tags], type: Gin)
  @@map("vocabulary_item")
  @@schema("kiko")
}

/// A reading: pinyin (zh), kana (ja) or IPA (en). Replaced as a set on edit.
model Pronunciation {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId      String @map("owner_id") @db.Uuid
  vocabularyId String @map("vocabulary_id") @db.Uuid
  languageCode String @map("language_code")
  notation     String
  value        String
  position     Int

  vocabulary VocabularyItem @relation(fields: [vocabularyId, ownerId, languageCode], references: [id, ownerId, languageCode], onDelete: Cascade, onUpdate: NoAction)

  @@unique([vocabularyId, position])
  @@map("pronunciation")
  @@schema("kiko")
}

/// A sentence the word was saved from: always a segment of a published version.
/// Words added by hand simply have no occurrence (DEC-044).
model VocabularyOccurrence {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId             String   @map("owner_id") @db.Uuid
  vocabularyId        String   @map("vocabulary_id") @db.Uuid
  languageCode        String   @map("language_code")
  lessonId            String   @map("lesson_id") @db.Uuid
  transcriptVersionId String   @map("transcript_version_id") @db.Uuid
  segmentId           String   @map("segment_id") @db.Uuid
  /// Segment text at save time (published segments are immutable; kept for export/history).
  sourceText          String   @map("source_text")
  selectedText        String   @map("selected_text")
  /// Code-point offsets into source_text, end exclusive (DEC-022 counting).
  offsetStart         Int      @map("offset_start")
  offsetEnd           Int      @map("offset_end")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  vocabulary        VocabularyItem    @relation(fields: [vocabularyId, ownerId, languageCode], references: [id, ownerId, languageCode], onDelete: Cascade, onUpdate: NoAction)
  lesson            Lesson            @relation(fields: [lessonId, ownerId, languageCode], references: [id, ownerId, languageCode], onDelete: Restrict, onUpdate: NoAction)
  transcriptVersion TranscriptVersion @relation(fields: [transcriptVersionId, ownerId, languageCode], references: [id, ownerId, languageCode], onDelete: Restrict, onUpdate: NoAction)
  segment           Segment           @relation(fields: [segmentId, ownerId, languageCode], references: [id, ownerId, languageCode], onDelete: Restrict, onUpdate: NoAction)

  @@unique([vocabularyId, segmentId, offsetStart, offsetEnd])
  @@index([ownerId, lessonId])
  @@map("vocabulary_occurrence")
  @@schema("kiko")
}

/// Example sentence typed by the learner (audio comes with KIKO-011).
model VocabularyExample {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId      String  @map("owner_id") @db.Uuid
  vocabularyId String  @map("vocabulary_id") @db.Uuid
  languageCode String  @map("language_code")
  position     Int
  text         String
  reading      String?
  translation  String?

  vocabulary VocabularyItem @relation(fields: [vocabularyId, ownerId, languageCode], references: [id, ownerId, languageCode], onDelete: Cascade, onUpdate: NoAction)

  @@unique([vocabularyId, position])
  @@map("vocabulary_example")
  @@schema("kiko")
}

/// Undirected link between two words of the same learner and language.
model VocabularyRelation {
  ownerId          String   @map("owner_id") @db.Uuid
  fromVocabularyId String   @map("from_vocabulary_id") @db.Uuid
  toVocabularyId   String   @map("to_vocabulary_id") @db.Uuid
  languageCode     String   @map("language_code")
  kind             String
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  from VocabularyItem @relation("RelationFrom", fields: [fromVocabularyId, ownerId, languageCode], references: [id, ownerId, languageCode], onDelete: Cascade, onUpdate: NoAction)
  to   VocabularyItem @relation("RelationTo", fields: [toVocabularyId, ownerId, languageCode], references: [id, ownerId, languageCode], onDelete: Cascade, onUpdate: NoAction)

  @@id([fromVocabularyId, toVocabularyId])
  @@index([ownerId, toVocabularyId])
  @@map("vocabulary_relation")
  @@schema("kiko")
}

/// A learner's named word list in one language.
model Deck {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId      String    @map("owner_id") @db.Uuid
  languageCode String    @map("language_code")
  title        String
  version      Int       @default(1)
  archivedAt   DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner    UserProfile @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  language Language    @relation(fields: [languageCode], references: [code], onDelete: Restrict)
  items    DeckItem[]

  @@unique([id, ownerId, languageCode])
  @@index([ownerId, languageCode, archivedAt])
  @@map("deck")
  @@schema("kiko")
}

/// Membership of a word in a deck; removing it never deletes the word.
model DeckItem {
  deckId       String   @map("deck_id") @db.Uuid
  vocabularyId String   @map("vocabulary_id") @db.Uuid
  ownerId      String   @map("owner_id") @db.Uuid
  languageCode String   @map("language_code")
  addedAt      DateTime @default(now()) @map("added_at") @db.Timestamptz(6)

  deck       Deck           @relation(fields: [deckId, ownerId, languageCode], references: [id, ownerId, languageCode], onDelete: Cascade, onUpdate: NoAction)
  vocabulary VocabularyItem @relation(fields: [vocabularyId, ownerId, languageCode], references: [id, ownerId, languageCode], onDelete: Cascade, onUpdate: NoAction)

  @@id([deckId, vocabularyId])
  @@index([ownerId, vocabularyId])
  @@map("deck_item")
  @@schema("kiko")
}
